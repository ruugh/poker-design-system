{
  "name": "@ruugh/poker-design-system",
  "version": "0.2.0",
  "description": "End-to-end design system for Poker Manager — Figma variables to production code, one source of truth.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6107 --no-open",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "verify": "npm run build:tokens && npm run lint:css && npm run lint:tokens && npm run lint:parity && npm run typecheck",
    "test": "vitest run",
    "build": "npm run build:tokens && tsup",
    "prepack": "npm run build",
    "release": "changeset publish",
    "new:component": "node scripts/new-component.mjs",
    "lint:parity": "node scripts/lint-parity.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "chromatic": "^18.1.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.14",
    "style-dictionary": "^5.5.0",
    "stylelint": "^16.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.20",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.15"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./tokens": {
      "types": "./lib/tokens.d.ts",
      "import": "./lib/tokens.js",
      "require": "./lib/tokens.cjs"
    },
    "./styles.css": "./lib/index.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "lib",
    "dist/tokens.css",
    "dist/tokens.json"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruugh/poker-design-system.git"
  },
  "overrides": {
    "human-id": "^3.0.0"
  }
}
