  "Display": {
    "Metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "Bold",
        "fontSize": "30px",
        "lineHeight": "36px",
        "letterSpacing": "0",
        "textCase": "none"
      }
    },
    "MetricSm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": "SemiBold",
        "fontSize": "20px",
        "lineHeight": "26px",
        "letterSpacing": "0",
        "textCase": "none"
      }
    }
  }
