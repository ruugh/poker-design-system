        "letterSpacing": "0",
        "textCase": "none"
      }
    }
  },
  "Button": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter",
      "fontWeight": "Medium",
      "fontSize": "14px",
      "lineHeight": "22px",
      "letterSpacing": "0",
      "textCase": "none"
    }
